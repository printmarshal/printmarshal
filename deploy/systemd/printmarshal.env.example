# /etc/printmarshal/printmarshal.env -- environment for printmarshal.service.
# Keep it root:printmarshal 0640: it may hold secrets.  One KEY=value per line,
# no quotes needed, no shell expansion.  Full reference: docs/operations.md.

# HTTP listen address for the UI and API.  Put a TLS reverse proxy in front and
# bind to loopback: PM_LISTEN=127.0.0.1:8080
PM_LISTEN=:8080

# Database, secret.key and firmware packages live here (systemd creates it).
PM_DATA_DIR=/var/lib/printmarshal

# Optional JSON config for notifiers, alert thresholds, discovery targets, ...
# (see deploy/printmarshal.example.json).  Environment variables override it.
#PM_CONFIG=/etc/printmarshal/printmarshal.json

# SNMP trap listener.  162 works because the unit grants CAP_NET_BIND_SERVICE;
# use 1162 if you removed that.  Printers must be told the same port.
PM_TRAP_ENABLED=true
PM_TRAP_LISTEN=0.0.0.0:162

# Polling and discovery
PM_POLL_INTERVAL=5m
PM_POLL_CONCURRENCY=32
PM_DISCOVERY_ENABLED=false
#PM_DISCOVERY_INTERVAL=1h
#PM_DISCOVERY_TARGETS=10.20.0.0/22,10.21.5.0/24
#PM_JOB_WORKERS=4

# Initial admin password: read ONLY on the first start with an empty database.
# Leave unset to have one generated and printed once in `journalctl -u printmarshal`.
#PM_ADMIN_PASSWORD=change-me-on-first-login

# Encryption key for stored device credentials: base64 of 32 random bytes
# (`openssl rand -base64 32`).  Leave unset to have it generated into
# /var/lib/printmarshal/secret.key (mode 0600).  Either way BACK IT UP: without
# the key every stored credential is unrecoverable.
#PM_SECRET_KEY=

# Set to true once a TLS reverse proxy terminates HTTPS in front of PrintMarshal
# so the session cookie is never sent over plain HTTP.
PM_SECURE_COOKIES=false

# Logging: text|json (json is easiest for journald/log shippers), debug|info|warn|error
PM_LOG_FORMAT=json
PM_LOG_LEVEL=info

# SMTP password for a notifier whose "passwordEnv" is PM_SMTP_PASSWORD.
#PM_SMTP_PASSWORD=
