{
  "listen": ":8080",
  "dataDir": "/data",
  "database": "sqlite",
  "poll": { "interval": "5m", "concurrency": 32, "snmpTimeout": "2s", "snmpRetries": 1, "ippTimeout": "4s", "ippInsecureTls": true },
  "discovery": {
    "enabled": false,
    "interval": "1h",
    "mdnsWait": "5s",
    "wsdWait": "3s",
    "scanWorkers": 64,
    "maxAddresses": 4096,
    "targets": ["10.0.0.0/24"]
  },
  "trap": { "enabled": true, "listen": "0.0.0.0:1162" },
  "alerts": { "supplyWarningPercent": 15, "supplyCriticalPercent": 5, "offlineAfterFailures": 2 },
  "notifiers": [
    { "name": "ops-slack", "type": "slack", "url": "https://hooks.slack.com/services/XXX/YYY/ZZZ", "events": ["alert.raised", "alert.cleared"] },
    { "name": "generic", "type": "webhook", "url": "https://example.internal/hooks/printmarshal", "events": ["*"] },
    { "name": "mail", "type": "smtp", "host": "smtp.example.com", "port": 587, "startTls": true, "from": "printmarshal@example.com",
      "to": ["print-team@example.com"], "username": "printmarshal@example.com", "passwordEnv": "PM_SMTP_PASSWORD", "events": ["alert.raised"] }
  ],
  "jobs": { "workers": 4 },
  "auth": { "sessionTtl": "720h", "secureCookies": false },
  "telemetry": { "retention": "2160h" }
}
